# Example only. Replace with your real values locally.

BACKUP_NAME="homeserver"
LOCAL_BACKUP_ROOT="/var/backups/homeserver/snapshots"
RCLONE_REMOTE_DEST="yadisk:server_backup"
RETENTION_LOCAL=1
RETENTION_REMOTE=30
INCLUDE_PATHS="/etc /root/.acme.sh /home/ubuntu/.ssh /usr/local/x-ui /usr/local/sbin/homeserver-backup.sh /usr/local/sbin/homeserver-restore.sh /usr/local/sbin/homeserver-bootstrap-restore.sh /etc/homeserver-backup.env /etc/homeserver-backup.exclude"
EXCLUDES_FILE="/etc/homeserver-backup.exclude"
REMOTE_SNAPSHOTS_PREFIX="snapshots"
REMOTE_OBJECTS_PREFIX="objects"
ENABLE_LOCAL_GC=1
ENABLE_REMOTE_GC=1
CONTAINER_NAME="mtg-proxy-8443"
TELEGRAM_BOT_TOKEN="REPLACE_ME"
TELEGRAM_CHAT_ID="REPLACE_ME"
MAIL_TO="user@example.com"
TELEGRAM_SOCKS5_PROXY="192.168.100.2:10808"
PRIMARY_SERVICE_IP="192.168.100.2"
RESTORE_MODE="disaster"
RESTORE_TEST_TARGET_IP=""
ALLOW_RESTORE="NO"
SKIP_REMOTE_UPLOAD=0
PROGRESS_NOTIFY_EVERY_SEC=900
